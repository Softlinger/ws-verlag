# Fuer lokale Entwicklung reicht die Standard-SQLite-Datei (siehe app/config.py).
# Fuer den Produktivbetrieb auf MariaDB umstellen, z. B.:
# DATABASE_URL=mysql+pymysql://ws_verlag_user:CHANGE_ME@localhost:3306/ws_verlag
DATABASE_URL=sqlite:///./ws_verlag.db

# Unbedingt aendern (z. B. mit: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=change-me-in-production-please

PORT=8000
