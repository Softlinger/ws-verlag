# Datenbank: ausschliesslich MariaDB (SQLite wird in diesem Projekt nicht mehr
# unterstuetzt). Im Docker-Betrieb setzt der app-Service in docker-compose.yml die
# DATABASE_URL selbst (mysql+pymysql://...@mariadb:3306/ws_verlag) - fuer den Start
# per "docker compose" brauchst du hier also keine DATABASE_URL. Sie ist nur noetig,
# wenn du die App direkt auf dem Host (ohne Docker) laufen laesst:
# DATABASE_URL=mysql+pymysql://ws_verlag:CHANGE_ME@localhost:3306/ws_verlag

# Fuer "poetry run pytest": die Tests laufen gegen eine echte MariaDB. Eine erreichbare
# Instanz bereitstellen (z. B. mariadb:11 per Docker) und Ziel-URL hier setzen:
# TEST_DATABASE_URL=mysql+pymysql://root:CHANGE_ME@localhost:3306/ws_verlag_test

# Unbedingt aendern (z. B. mit: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=change-me-in-production-please

PORT=8000

# Nur fuer Docker-/NAS-Betrieb (docker-compose.yml) relevant:
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-too
WS_VERLAG_IMAGE=ws-verlag-app:local

# Fuer den automatischen Selbst-Update-Mechanismus: GitHub Personal Access Token mit
# Scope "read:packages", damit der Updater-Container das Image von ghcr.io ziehen kann
# (ein "docker login" auf dem Host reicht dafuer NICHT, siehe README-DEPLOYMENT.md).
# Erzeugen unter: https://github.com/settings/tokens
GHCR_USERNAME=dein-github-benutzername
GHCR_TOKEN=ghp_xxx

# Gemeinsames Geheimnis App <-> Updater-Container (sichert /updates/report gegen
# Manipulation). Beliebig langer Zufallswert, z. B.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Muss in .env stehen (wird von docker-compose an App UND Updater weitergegeben).
UPDATER_TOKEN=

# Optional: Base64 Ed25519-Public-Key (raw 32 Bytes). Leer => Update-Manifest wird nur
# ueber HTTPS vertraut. Wenn gesetzt, prueft die App das Feld "signature" des Manifests
# (Schutz gegen kompromittierte Website/Registry). Public-Key erzeugen z. B. mit
# `poetry run python -c "from app.services.update_signing import generate_keypair_b64 as g; print(g())"`.
UPDATE_MANIFEST_PUBLIC_KEY=

