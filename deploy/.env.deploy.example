# Kopieren nach deploy/.env.deploy und mit echten Werten fuellen.
# deploy/.env.deploy ist in .gitignore ausgeschlossen - NIEMALS committen.

FTP_HOST=host39.ssl-net.net
FTP_USER=change-me
FTP_PASSWORD=change-me
# Zielverzeichnis auf dem Webserver, in das release_upload/ hochgeladen wird.
# Achtung: relativ zum FTP-Basisverzeichnis des Accounts (nicht "/"!) - das
# Basisverzeichnis dieses Accounts enthaelt u. a. "weidlinger-soft/", darunter "apps/".
FTP_REMOTE_DIR=weidlinger-soft/apps/ws-verlag
